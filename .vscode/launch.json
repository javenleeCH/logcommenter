{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "logcommenter (inject sample.cpp)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/windows-msvc/logcommenter.exe",
            "args": [
                "--inject",
                "--file", "${workspaceRoot}/src/sample.cpp",
                "--var", "total",
                "--compile-commands", "${workspaceRoot}/build/windows-msvc/compile_commands.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": []
        },
        {
            "name": "logcommenter (inject sample.cpp) [debug]",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceRoot}/build/windows-msvc-debug/logcommenter.exe",
            "args": [
                "--inject",
                "--file", "${workspaceRoot}/src/sample.cpp",
                "--var", "total",
                "--compile-commands", "${workspaceRoot}/build/windows-msvc-debug/compile_commands.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceRoot}",
            "environment": []
        }
    ]
}
