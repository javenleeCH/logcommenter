{
  // 基于 CodeLLDB 插件的调试配置（需安装 vscode-lldb 扩展）。
  // debug 配置额外映射 LLVM 源码：编译机路径 -> 本地 .toolchain-debug/llvm-src
  // （源码树由 tools/fetch_llvm.sh 23.1.3 <dest> debug 下载解压）。
  "version": "0.2.0",
  "configurations": [
    {
      "name": "logcommenter (Windows MSVC Debug, codelldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-msvc-debug/logcommenter.exe",
      "args": [
        "--inject",
        "--file", "${workspaceFolder}/src/sample.cpp",
        "--var", "total",
        "--compile-commands", "${workspaceFolder}/build/windows-msvc-debug/compile_commands.json"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (Windows MSVC Debug)",
      "sourceMap": {
        "D:\\a\\logcommenter\\logcommenter\\llvm-project": "${workspaceFolder}/.toolchain-debug/llvm-src",
        "/home/runner/work/logcommenter/logcommenter/llvm-project": "${workspaceFolder}/.toolchain-debug/llvm-src"
      }
    },
    {
      "name": "logcommenter (Windows MSVC, codelldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/windows-msvc/logcommenter.exe",
      "args": [
        "--inject",
        "--file", "${workspaceFolder}/src/sample.cpp",
        "--var", "total",
        "--compile-commands", "${workspaceFolder}/build/windows-msvc/compile_commands.json"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "Build (Windows MSVC)"
    },
    {
      "name": "logcommenter (Linux Debug, codelldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/unix-default-debug/logcommenter",
      "args": [
        "--inject",
        "--file", "${workspaceFolder}/src/sample.cpp",
        "--var", "total",
        "--compile-commands", "${workspaceFolder}/build/unix-default-debug/compile_commands.json"
      ],
      "cwd": "${workspaceFolder}",
      "sourceMap": {
        "/home/runner/work/logcommenter/logcommenter/llvm-project": "${workspaceFolder}/.toolchain-debug/llvm-src"
      }
    },
    {
      "name": "logcommenter (Linux, codelldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/build/unix-default/logcommenter",
      "args": [
        "--inject",
        "--file", "${workspaceFolder}/src/sample.cpp",
        "--var", "total",
        "--compile-commands", "${workspaceFolder}/build/unix-default/compile_commands.json"
      ],
      "cwd": "${workspaceFolder}"
    }
  ]
}
