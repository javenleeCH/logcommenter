{
    "version": 8,
    "configurePresets": [
        {
            "name": "ninja",
            "displayName": "Ninja (cross-platform)",
            "description": "Ninja; toolchain auto-detected (cl / gcc / clang), override via CC/CXX env or -DCMAKE_CXX_COMPILER",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/out/install/${presetName}"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "ninja-debug",
            "displayName": "Debug",
            "configurePreset": "ninja",
            "configuration": "Debug"
        },
        {
            "name": "ninja-release",
            "displayName": "Release",
            "configurePreset": "ninja",
            "configuration": "Release"
        }
    ],
    "testPresets": [
        {
            "name": "ninja",
            "displayName": "run unit tests",
            "configurePreset": "ninja",
            "output": { "outputOnFailure": true }
        }
    ],
    "workflowPresets": [
        {
            "name": "all",
            "displayName": "configure + build + test (one command)",
            "steps": [
                { "type": "configure", "name": "ninja" },
                { "type": "build", "name": "ninja-debug" },
                { "type": "test", "name": "ninja" }
            ]
        }
    ]
}
